<workout_file>
  <author>Amedee Railleur</author>
  <name>AR B1 - Force-endurance 4x6</name>
  <description>75 min. 4 x 6 min a 80% FTP a 60-65 rpm, recup 4 min a 60%. Bloc 1 semaine 1.</description>
  <sportType>bike</sportType>
  <tags><tag name="BLOC1"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.50" PowerHigh="0.70">
      <textevent timeoffset="10" message="Echauffement progressif"/>
    </Warmup>
    <SteadyState Duration="300" Power="0.65" Cadence="90"/>
    <IntervalsT Repeat="4" OnDuration="360" OffDuration="240" OnPower="0.80" OffPower="0.60" Cadence="62" CadenceResting="90">
      <textevent timeoffset="0" message="6 min a 80% FTP, 60-65 rpm, assis, gainage actif, pas d'a-coups"/>
    </IntervalsT>
    <SteadyState Duration="600" Power="0.68" Cadence="90"/>
    <Cooldown Duration="600" PowerLow="0.55" PowerHigh="0.45">
      <textevent timeoffset="5" message="Retour au calme. Routine Post Velo apres la seance"/>
    </Cooldown>
  </workout>
</workout_file>
